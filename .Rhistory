O_cov_regional <- O_crude_cov$cov_table_long %>% mutate(subgroup="Global") %>%
bind_rows(O_crude_cov_WA$cov_table_long %>% mutate(subgroup="Western Africa")) %>%
bind_rows(O_crude_cov_EA$cov_table_long %>% mutate(subgroup="Eastern Africa")) %>%
bind_rows(O_crude_cov_SA$cov_table_long %>% mutate(subgroup="Southern Africa")) %>%
bind_rows(O_crude_cov_SAsia$cov_table_long %>% mutate(subgroup="Southern Asia")) %>%
filter(type=="raw") %>%
mutate(subgroup=fct_relevel(subgroup, c("Global", "Southern Asia", "Eastern Africa", "Southern Africa", "Western Africa"))) %>%
ggplot(aes(x=rank, y=value*100, group=subgroup)) +
geom_hline(yintercept=70, linetype=2) +
geom_vline(xintercept=c(5,10), col="grey") +
geom_line(aes(col=subgroup), lwd=1) +
theme_bw() +
ylim(0,100) +
labs(x=NULL, y="Coverage", colour="Subgroup") +
theme(axis.text.x = element_text(angle=45, hjust=1, size=9), panel.grid.minor.x = element_blank()) +
scale_x_continuous(breaks=seq(1,nrow(O_crude_ranks)),
labels=O_crude_ranks$locus, limits=c(1,nrow(O_crude_ranks))) +
scale_color_manual(values=region_cols)
O_cov_regional + geom_vline(xintercept = c(5,10), col="grey")
ggsave("Ocov_simplePooled_global_regional.pdf", width=9, height=6, device = cairo_pdf, family = "Arial Unicode MS")
ggsave("Ocov_simplePooled_global_regional.png", width=9, height=6)
O_cov_groups + geom_vline(xintercept = c(5,10), col="grey") + O_cov_regional + geom_vline(xintercept = c(5,10), col="grey") + plot_layout(guides = "collect", axes="collect")
ggsave("Ocov_simplePooled_global_regional_subgroups.pdf", width=8, height=4, device = cairo_pdf, family = "Arial Unicode MS")
ggsave("Ocov_simplePooled_global_regional_subgroups.png", width=8, height=4)
o_prev_global_bar + o_regionCrudeHeat + O_cov_regional + geom_vline(xintercept = c(5,10), col="grey") +ggtitle("O coverage") + plot_layout(guides="collect")
ggsave("Oprev_cov_simplePooled_global_regional.pdf", width=12, height=6, device = cairo_pdf, family = "Arial Unicode MS")
ggsave("Oprev_cov_simplePooled_global_regional.png", width=12, height=6)
overall_summary <- data_NNS_sites10 %>%
summarise(`Unique Sites`=length(unique(Site)),
N=n(),
`Unique K loci`=length(unique(K_locus[K_locus_confidence =="Typeable"])),
`Unique O types`=length(unique(O_genotype[O_locus_confidence =="Typeable"]))) %>%
mutate(Country="-", Study="-", Period="-", Region="Total")
region_summary <- data_NNS_sites10 %>%
group_by(Region) %>%
summarise(`Unique Sites`=length(unique(Site)),
N=n(),
`Unique K loci`=length(unique(K_locus[K_locus_confidence =="Typeable"])),
`Unique O types`=length(unique(O_genotype[O_locus_confidence =="Typeable"]))) %>%
mutate(Country="All", Study="-", Period="-")
country_summary <- data_NNS_sites10 %>%
group_by(Region, Country, Study) %>%
summarise(`Unique Sites`=length(unique(Site)),
N=n(),
`Unique K loci`=length(unique(K_locus[K_locus_confidence =="Typeable"])),
`Unique O types`=length(unique(O_genotype[O_locus_confidence =="Typeable"])),
min=min(Year), max=max(Year)) %>%
mutate(Period=paste0(min, "-", max)) %>%
ungroup() %>%
bind_rows(region_summary) %>%
bind_rows(overall_summary) %>%
select(-c(min, max)) %>% relocate(Period, .after=N) %>%
arrange(Country) %>%
mutate(Region=fct_relevel(Region,c("Eastern Africa", "Southern Africa", "Western Africa", "Southern Asia", "Total"))) %>%
arrange(Region)
# write to file
write_tsv(country_summary, file="country_study_breakdown.tsv")
# count per country
studies_by_country <- data_NNS_sites10 %>% group_by(Region, Country, Study) %>% count()
write_tsv(studies_by_country, file="country_study_list.tsv")
ecoli <- read_excel("pan_ecoli_ectyper_combined_output_18July25_11.07.xlsx") %>%
mutate(Study=if_else(Country=="Benin", "KLEBECO", Study)) %>%
mutate(Study=if_else(Study=="MLW archive", "MLW", Study)) %>%
mutate(Study=if_else(Study=="Baby_GERMS", "BabyGERMS", Study))
kpn <- data_NNS %>%
select(`Genome Name`, Study, Region, Country, Cluster, neonatal, Year, K_locus, Cluster) %>%
rename(Type=K_locus) %>%
rename(Name=`Genome Name`) %>%
mutate(Species="Kpn")
ec <- ecoli %>% select(Name, Study, Country, Date, `O-type`) %>%
rename(Type=`O-type`) %>%
mutate(Species="Ec") %>%
mutate(Cluster=as.character(row_number()))
kpn_ec <- bind_rows(kpn, ec) %>%
filter(Study %in% c("BARNARDS", "BabyGERMS", "KLEBECO", "MBIRA", "MLW"))
country_count <- kpn_ec %>%
group_by(Country) %>% count() %>%
rename(countryN=n)
crude_country <- kpn_ec %>%
group_by(Type, Country) %>% count() %>%
left_join(country_count) %>%
mutate(p_country=n/countryN)
crude_overall <- crude_country %>%
filter(Type!="-") %>%
group_by(Type) %>%
summarise(mean=mean(p_country)) %>%
arrange(-mean) %>%
mutate(rawRank=row_number(desc(mean)))
crude <- kpn_ec %>%
group_by(Type) %>%
count() %>%
arrange(-n) %>%
ungroup() %>%
#filter(Type!="-") %>%
#filter(Type!="NT") %>%
mutate(rank=row_number())
crude
crude_overall_bar <- crude %>%
filter(rank<=30) %>%
filter(Type!="NT") %>%
mutate(spp=if_else(grepl("KL",Type), "Kp", "Ec") %>%
arrange(-rank) %>%
ggplot(aes(x=n/nrow(kpn_ec)*100, y=Type)) +
geom_col(fill=spp) +
