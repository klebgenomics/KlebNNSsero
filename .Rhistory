geom_hline(yintercept=9.5, col="darkgrey") +
geom_hline(yintercept=19.5, col="darkgrey") +
scale_y_discrete(limits=rev(crude$Type[1:30]))+
theme_bw() +
labs(y=NULL, x="Global prevalence (%)", title="Raw Global prevalence") +
theme(axis.text.y=element_text(size=8))
crude_overall_bar
