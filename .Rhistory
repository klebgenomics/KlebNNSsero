kpn_ec %>% group_by(Country, Study, Species) %>% count() %>% pivot_wider(names_from=Species, values_from=n) %>% write_tsv("Kpn_Ec_data_summary.tsv")
K_crude_ecSites <- kpn_ec %>%
raw_adj_prop(grouping_vars = c("Type"), summarise_by = "Type", adj_vars = c("Cluster")) %>%
mutate(raw_prop = raw_count/nrow(kpn_ec)) %>%
mutate(adj_prop = adj_count/length(unique(kpn_ec$Cluster))) %>%
mutate(rawRank=row_number(desc(raw_count))) %>%
mutate(adjRank=row_number(desc(adj_count))) %>%
mutate(adj_se=sqrt(adj_prop*(1-adj_prop)/adj_sum)) %>%
mutate(adj_lower=adj_prop-1.96*adj_se) %>%
mutate(adj_upper=adj_prop+1.96*adj_se) %>%
mutate(raw_se=sqrt(raw_prop*(1-raw_prop)/raw_sum)) %>%
mutate(raw_lower=raw_prop-1.96*raw_se) %>%
mutate(raw_upper=raw_prop+1.96*raw_se)
# global ranks
K_crude_ranks_ecSites <- K_crude_ecSites %>% select(Type, adjRank, rawRank)
combined_prev_global_bar <- K_crude_ecSites %>% filter(adjRank<=30) %>%
ggplot(aes(x=adj_prop*100, y=Type)) +
geom_col(fill="skyblue") +
#geom_errorbar(aes(xmin = adj_lower*100, xmax= adj_upper*100)) +
geom_hline(yintercept=10.5, col="darkgrey") +
geom_hline(yintercept=20.5, col="darkgrey") +
scale_y_discrete(limits=rev(K_crude_ranks_ecSites$Type[1:30]))+
theme_bw() +
labs(y=NULL, x="Global prevalence (%)", title="Cluster-adjusted Global prevalence") +
theme(axis.text.y=element_text(size=8))
combined_prev_global_bar
K_crude_ecSites_noNT <- K_crude_ecSites %>% filter(Type!="NT")
combined_prev_global_bar <- K_crude_ecSites_noNT %>%
filter(adjRank<=30) %>%
mutate(spp=if_else(grepl("KL",Type), "Kp", "Ec")) %>%
ggplot(aes(x=adj_prop*100, y=Type, fill=spp)) +
geom_col() +
#geom_errorbar(aes(xmin = adj_lower*100, xmax= adj_upper*100)) +
geom_hline(yintercept=10.5, col="darkgrey") +
geom_hline(yintercept=20.5, col="darkgrey") +
scale_y_discrete(limits=rev(K_crude_ecSites_noNT$Type[1:30]))+
theme_bw() +
labs(y=NULL, x="Global prevalence (%)", title="Cluster-adjusted Global prevalence") +
theme(axis.text.y=element_text(size=8))
combined_prev_global_bar
