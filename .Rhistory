uganda_dist <- read_csv("Uganda/Uganda_neonatal_Kp_pathogenwatch-klepn-ee0sgqfglmpf-ugandaneonatalkp-difference-matrix.csv")
uganda_kleborate <- read_csv("Uganda/Uganda_neonatal_Kp_pathogenwatch-klepn-ee0sgqfglmpf-ugandaneonatalkp-kleborate.csv")
# 23 samples
dim(uganda_kleborate)
dim(uganda_dist)
sum(uganda_kleborate$`Genome Name` %in% uganda_dist$Name)
uganda_meta <- read_excel("Uganda/Kp_neonatal_Uganda_metadata.xlsx") %>%
rename(Name=`Isolate ID`)
dim(uganda_meta)
sum(uganda_kleborate$`Genome Name` %in% uganda_meta$Name)
uganda_meta <- uganda_meta %>%
filter(!(`Gestational age by APGAR` == "Stillbirth")| is.na(`Gestational age by APGAR`)) %>%  # exclude 3 recorded as stillbirth
filter(!is.na(`Date of collection`)) %>% # exclude 3 with unknown date (these also have unknown site)
filter(`Geographic collection site`=="Kawempe") %>%
select(Name, Country, `Isolation site`, `Date of collection`)
# leaves 16
sum(uganda_kleborate$`Genome Name` %in% uganda_meta$Name)
# convert to pairwise distance table, for pairs within day threshold
uganda_dist_withinSites <- uganda_dist %>%
pivot_longer(cols = !Name, values_to = 'dist', names_to = 'iso2') %>%
left_join(uganda_meta) %>%
select(Name, iso2, dist, `Date of collection`) %>%
rename(iso1=Name, date1=`Date of collection`) %>%
rename(Name = iso2) %>%
left_join(uganda_meta) %>%
select(iso1, Name, dist, date1, `Date of collection`) %>%
rename(iso2=Name, date2=`Date of collection`) %>%
filter(abs(as.Date(date1)-as.Date(date2)) <= day_threshold) %>%
select(iso1, iso2, dist)
# use function to cluster based on distances, and update Kleborate input file with 'Cluster' column
uganda_kleborate <- get_cluster_membership_from_distmat(uganda_kleborate, uganda_dist_withinSites, snp_dist=snp_threshold) %>%
mutate(Study="Uganda") %>% # add study name
left_join(uganda_meta, join_by("Genome Name"=="Name")) %>%
mutate(`Age group` = "0-28 days") %>%
mutate(Site="Kawempe") %>% # add site name
mutate(Date=as.Date(`Date of collection`))%>%
mutate(Year=as.double(format(Date,'%Y'))) %>%
mutate(Cluster=paste0("UGK",Cluster))
# write out cluster-annotated file
write.csv(uganda_kleborate, paste0(output_dir,"/Uganda_Kleborate3.csv"), row.names=F)
